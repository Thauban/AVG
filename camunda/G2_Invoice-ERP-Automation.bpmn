        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0zlsez0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ComplianceResult_Ok" name="Ok" sourceRef="Gateway_ComplianceResult" targetRef="Task_ManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= complianceOk = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ComplianceRequired_No" name="Nein" sourceRef="Gateway_ComplianceRequired" targetRef="Task_ManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= complianceRequired = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManualReview_Decision" sourceRef="Task_ManualReview" targetRef="Gateway_ManualDecision" />
    <bpmn:sequenceFlow id="Flow_InputChannel_EDI" name="EDI" sourceRef="Gateway_InputChannel" targetRef="Task_ImportEDIInvoice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= inputChannel = "edi"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_EDI_Register" sourceRef="Task_ImportEDIInvoice" targetRef="Task_RegisterOrUpdateInvoice_gRPC" />
    <bpmn:sequenceFlow id="Flow_Start_InputChannel" sourceRef="StartEvent_InvoiceReceived" targetRef="Gateway_InputChannel" />
    <bpmn:sequenceFlow id="Flow_0zlsez0" sourceRef="Event_0kbkuyz" targetRef="Gateway_InputChannel" />
    <bpmn:sequenceFlow id="Flow_InputChannel_MailPortal" name="Email / Portal" sourceRef="Gateway_InputChannel" targetRef="Task_AIExtractInvoice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= inputChannel != "edi"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManualDecision_Reject" name="Ablehnen" sourceRef="Gateway_ManualDecision" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualDecision = "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Archive_End" sourceRef="Task_ArchiveInvoice" targetRef="EndEvent_Completed" />
    <bpmn:sequenceFlow id="Flow_Payment_Archive" sourceRef="Task_ExecutePayment" targetRef="Task_ArchiveInvoice" />
    <bpmn:sequenceFlow id="Flow_ErpSync_Payment" sourceRef="Task_ErpSync" targetRef="Task_ExecutePayment" />
    <bpmn:sequenceFlow id="Flow_Approve_ErpSync" sourceRef="Task_ApproveInvoice" targetRef="Task_ErpSync" />
    <bpmn:sequenceFlow id="Flow_ManualDecision_Approve" name="Freigeben" sourceRef="Gateway_ManualDecision" targetRef="Task_ApproveInvoice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualDecision = "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ComplianceNeed_Gateway" sourceRef="Task_CheckComplianceNeed" targetRef="Gateway_ComplianceRequired" />
    <bpmn:sequenceFlow id="Flow_ComplianceRequired_Yes" name="Ja" sourceRef="Gateway_ComplianceRequired" targetRef="Task_ManualComplianceCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= complianceRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Update_Register" sourceRef="Task_UpdateInvoiceData" targetRef="Task_CheckComplianceNeed" />
    <bpmn:sequenceFlow id="Flow_PrepareCompliance_DMN" sourceRef="Task_PrepareComplianceDecision" targetRef="Task_CheckComplianceNeed" />
    <bpmn:sequenceFlow id="Flow_Register_PrepareCompliance" sourceRef="Task_RegisterOrUpdateInvoice_gRPC" targetRef="Task_PrepareComplianceDecision" />
    <bpmn:sequenceFlow id="Flow_ManualExtract_Register" sourceRef="Task_ExtractData_Manual" targetRef="Task_RegisterOrUpdateInvoice_gRPC" />
    <bpmn:sequenceFlow id="Flow_AIExtract_Review" sourceRef="Task_AIExtractInvoice" targetRef="Task_ReviewAIExtraction" />
    <bpmn:sequenceFlow id="Flow_AIReview_Register" sourceRef="Task_ReviewAIExtraction" targetRef="Task_RegisterOrUpdateInvoice_gRPC" />
    <bpmn:sequenceFlow id="Flow_ComplianceCheck_Result" sourceRef="Task_ManualComplianceCheck" targetRef="Gateway_ComplianceResult" />
    <bpmn:sequenceFlow id="Flow_ComplianceResult_Issue" name="Rückfrage nötig" sourceRef="Gateway_ComplianceResult" targetRef="Task_RequestMissingInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= complianceOk = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReceiveCorrection_Update" sourceRef="Task_ReceiveCorrection" targetRef="Task_UpdateInvoiceData" />
    <bpmn:sequenceFlow id="Flow_Request_ReceiveCorrection" sourceRef="Task_RequestMissingInformation" targetRef="Task_ReceiveCorrection" />
    <bpmn:sequenceFlow id="Flow_ManualDecision_Correction" name="Korrektur nötig" sourceRef="Gateway_ManualDecision" targetRef="Task_RequestMissingInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualDecision = "correction"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
